# Copie para apps/api/.env (ignorado pelo git). Nunca versione segredos.

NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Sem DATABASE_URL a API usa PGlite (PostgreSQL embarcado) em PGLITE_DIR.
# Em produção DATABASE_URL é obrigatória.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/calculadora_fiscal
PGLITE_DIR=.data/pglite

SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# COOKIE_SECURE=true   # obrigatório atrás de TLS; padrão: true em produção
TRUST_PROXY=false
LOG_LEVEL=info

# Seed inicial (npm run db:seed). Use uma senha forte e troque após o primeiro login.
SEED_ORGANIZATION_NAME=Contar Brasil
SEED_ORGANIZATION_SLUG=contar-brasil
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=troque-esta-senha-forte
